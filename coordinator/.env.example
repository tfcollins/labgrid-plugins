# Labgrid coordinator gRPC port (exposed to host)
LG_COORDINATOR_PORT=20408

# FastAPI backend port (exposed to host)
API_PORT=8000

# Web dashboard port (exposed to host)
WEB_PORT=3000

# Shared Bearer token used only by node installers to report deployment status.
# Generate a long random value, for example: openssl rand -hex 32
LG_DEPLOYMENT_TOKEN=

# Optional: show each place's NetBox device (rack, IP, power and console
# cabling) on its detail page. Read-only; a token with view permissions is enough.
# Not the NETBOX_URL / NETBOX_TOKEN that `adi-lg netbox add-hardware` reads.
# LG_NETBOX_URL=https://netbox.example.com
# LG_NETBOX_TOKEN=
# Base URL for links shown in the browser, if it differs from LG_NETBOX_URL.
# LG_NETBOX_PUBLIC_URL=
# For a NetBox behind an internal CA: a CA file inside the api container
# (mount it), or LG_NETBOX_VERIFY=false to skip certificate checks.
# LG_NETBOX_CA_BUNDLE=
# LG_NETBOX_VERIFY=true
