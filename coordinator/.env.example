# Labgrid coordinator gRPC port (exposed to host)
LG_COORDINATOR_PORT=20408

# FastAPI backend port (exposed to host)
API_PORT=8000

# Web dashboard port (exposed to host)
WEB_PORT=3000

# Shared Bearer token used only by node installers to report deployment status.
# Generate a long random value, for example: openssl rand -hex 32
LG_DEPLOYMENT_TOKEN=
