#!/bin/sh
# Minimal udhcpc hook for SD-recovery initramfs.

RESOLV_CONF="/etc/resolv.conf"
[ -n "$1" ] || { echo "no action"; exit 1; }
[ -n "$interface" ] || exit 1

case "$1" in
    deconfig)
        ifconfig $interface 0.0.0.0
        ;;
    bound|renew)
        ifconfig $interface $ip netmask $subnet
        if [ -n "$router" ]; then
            ip route del default 2>/dev/null
            for r in $router; do
                ip route add default via $r dev $interface
            done
        fi
        if [ -n "$dns" ]; then
            : > $RESOLV_CONF
            for d in $dns; do
                echo "nameserver $d" >> $RESOLV_CONF
            done
        fi
        ;;
esac
exit 0
