{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Labgrid Exporter Resource Configuration",
  "description": "Validates exporter YAML resource definitions for consistency",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_-]+$": {
      "type": "object",
      "description": "Resource group (e.g., VCU118_AD9081)",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "description": "Individual resource definition",
          "required": [
            "cls"
          ],
          "properties": {
            "cls": {
              "type": "string",
              "description": "Resource class name"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "known_resource_classes": {
      "enum": [
        "NetworkService",
        "RawSerialPort",
        "XilinxDeviceJTAG",
        "XilinxVivadoTool",
        "USBSDMuxDevice",
        "USBMassStorage",
        "MassStorageDevice",
        "TFTPServerResource",
        "KuiperRelease",
        "TickArtifacts",
        "APCOutlet",
        "CyberPowerOutlet",
        "DeditecRelais8",
        "Eth008DigitalOutput",
        "HIDRelay",
        "HomeAssistantOutlet",
        "HttpDigitalOutput",
        "KasaOutlet",
        "LAAPowerPort",
        "LXAIOBusPIO",
        "MatchedSysfsGPIO",
        "ModbusTCPCoil",
        "NetworkPowerPort",
        "OneWirePIO",
        "PDUDaemonPort",
        "SiSPMPowerPort",
        "SigrokUSBSerialDevice",
        "SysfsGPIO",
        "TasmotaPowerPort",
        "USBPowerPort",
        "VesyncOutlet",
        "WaveshareModbusTCPCoil",
        "YKUSHPowerPort"
      ]
    }
  }
}
