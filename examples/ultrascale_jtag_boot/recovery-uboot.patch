diff --git a/arch/arm/cpu/armv8/zynqmp/cpu.c b/arch/arm/cpu/armv8/zynqmp/cpu.c
index 47b7f3c0ae..82fb8fed20 100644
--- a/arch/arm/cpu/armv8/zynqmp/cpu.c
+++ b/arch/arm/cpu/armv8/zynqmp/cpu.c
@@ -236,13 +236,16 @@ int zynqmp_mmio_write(const u32 address,
 		      const u32 mask,
 		      const u32 value)
 {
+	int ret;
+
 	if (IS_ENABLED(CONFIG_SPL_BUILD) || current_el() == 3)
 		return zynqmp_mmio_rawwrite(address, mask, value);
-	else
-		return invoke_smc(ZYNQMP_MMIO_WRITE, address, mask,
-				  value, 0, NULL);
 
-	return -EINVAL;
+	ret = invoke_smc(ZYNQMP_MMIO_WRITE, address, mask, value, 0, NULL);
+	if (ret)
+		ret = zynqmp_mmio_rawwrite(address, mask, value);
+
+	return ret;
 }
 
 int zynqmp_mmio_read(const u32 address, u32 *value)
@@ -258,7 +261,10 @@ int zynqmp_mmio_read(const u32 address, u32 *value)
 	} else {
 		ret = invoke_smc(ZYNQMP_MMIO_READ, address, 0, 0,
 				 0, ret_payload);
-		*value = ret_payload[1];
+		if (ret)
+			ret = zynqmp_mmio_rawread(address, value);
+		else
+			*value = ret_payload[1];
 	}
 
 	return ret;
diff --git a/board/xilinx/zynqmp/zynqmp.c b/board/xilinx/zynqmp/zynqmp.c
index 9883ad2deb..57b9207a9a 100644
--- a/board/xilinx/zynqmp/zynqmp.c
+++ b/board/xilinx/zynqmp/zynqmp.c
@@ -277,6 +277,11 @@ int board_early_init_f(void)
 	int ret = 0;
 #if !defined(CONFIG_SPL_BUILD) && defined(CONFIG_CLK_ZYNQMP)
 	zynqmp_pmufw_version();
+
+	/* Recovery JTAG handoff: submit the production FSBL PM config object. */
+	ret = invoke_smc(0xC2000002, 0x00200000, 0, 0, 0, NULL);
+	if (ret)
+		printf("PM configuration object rejected: %d\n", ret);
 #endif
 
 #if defined(CONFIG_ZYNQMP_PSU_INIT_ENABLED)
