#!/bin/sh
# ZC706 SD-recovery initramfs entry point.
#
# Lots of early diagnostics so we can see WHERE this script gets to even
# when stdout isn't fully wired up yet. /dev/kmsg writes go to the kernel
# ring buffer and are always visible regardless of tty setup.

# Open /dev/console for stdin/stdout/stderr explicitly. /dev is populated
# by the cpio (it has /dev/console as char 5:1) before /init runs, so this
# should succeed even without devtmpfs mounted.
exec </dev/console >/dev/console 2>&1

# Mirror major milestones to /dev/kmsg as well — those land in dmesg.
echo "INIT: /init started, redirected to /dev/console" > /dev/kmsg
echo ""
echo "=========================================="
echo "  ZC706 SD Recovery initramfs"
echo "=========================================="

# Mount the standard pseudo-filesystems.
echo "INIT: mounting /proc /sys /dev" > /dev/kmsg
mount -t proc none /proc
mount -t sysfs none /sys
# Try devtmpfs; ignore if unsupported (cpio already provides essential nodes).
mount -t devtmpfs none /dev 2>/dev/null

echo "INIT: PATH=$PATH" > /dev/kmsg
export PATH=/sbin:/bin

# Loopback up
ifconfig lo 127.0.0.1 up

echo "Bringing up eth0 via DHCP..."
echo "INIT: about to udhcpc" > /dev/kmsg
udhcpc -i eth0 -n -q -t 15 -T 3 -s /etc/udhcpc/default.script
DHCP_RC=$?
echo "INIT: udhcpc rc=$DHCP_RC" > /dev/kmsg
ifconfig eth0 2>&1 | head -3

echo ""
echo "recovery login:"
echo "INIT: printed login prompt; waiting for username" > /dev/kmsg
read user
echo "Password:"
read pass
echo ""
echo "INIT: dropping to /bin/sh -i" > /dev/kmsg
hostname recovery
PS1='root@recovery:/# '
export PS1
cd /
exec /bin/sh -i
